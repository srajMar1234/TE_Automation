REPORTS_USERNAME=your_username
REPORTS_PASSWORD=your_password

# Optional: use installed Chrome when `playwright install chromium` fails (SSL / corp network).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Recommended on Windows: use Playwright's Chrome channel (more stable than executable_path alone).
# Do NOT set this on Snowflake — there is no Chrome at /opt/google/chrome/chrome.
# PLAYWRIGHT_USE_INSTALLED_CHROME=1
